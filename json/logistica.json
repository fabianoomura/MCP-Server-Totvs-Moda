  "paths": {
    "/api/totvsmoda/logistics/v2/product-storages/search": {
      "post": {
        "tags": [
          "ProductStorage"
        ],
        "summary": "Obter dados de armazenamento de produto.",
        "requestBody": {
          "description": "",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductStorageSearchModel"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductStorageSearchModel"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ProductStorageSearchModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductStorageSearchResponseModel"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DomainNotificationMessage"
                }
              }
            }
          }
        }
      }
    },
    "/api/totvsmoda/logistics/v2/product-packagings": {
      "post": {
        "tags": [
          "ProductStorage"
        ],
        "summary": "Manutenção de produto em embalagem.",
        "requestBody": {
          "description": "",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpsertProductPackagingCommand"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UpsertProductPackagingCommand"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpsertProductPackagingCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessProcessingModel"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DomainNotificationMessage"
                }
              }
            }
          }
        }
      }
    },
    "/api/totvsmoda/logistics/v2/product-packagings/add-quantity": {
      "post": {
        "tags": [
          "ProductStorage"
        ],
        "summary": "Adicionar quantidade em produto para uma embalagem.",
        "requestBody": {
          "description": "",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddQuantityProductPackagingCommand"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AddQuantityProductPackagingCommand"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AddQuantityProductPackagingCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessProcessingModel"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DomainNotificationMessage"
                }
              }
            }
          }
        }
      }
    },
    "/api/totvsmoda/logistics/v2/product-packagings/subtract-quantity": {
      "post": {
        "tags": [
          "ProductStorage"
        ],
        "summary": "Subtrair quantidade em produto para uma embalagem.",
        "requestBody": {
          "description": "",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubtractQuantityProductPackagingCommand"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SubtractQuantityProductPackagingCommand"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SubtractQuantityProductPackagingCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessProcessingModel"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DomainNotificationMessage"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddQuantityProductPackagingCommand": {
        "required": [
          "branchCode",
          "packagingNumber",
          "productCode",
          "quantity"
        ],
        "type": "object",
        "properties": {
          "branchCode": {
            "type": "integer",
            "description": "Código da empresa. Campo \"Empresa\" do componente CAPFM005.",
            "format": "int32"
          },
          "packagingNumber": {
            "type": "integer",
            "description": "Número da embalagem. Campo \"Código\" do componente CAPFM005.",
            "format": "int32"
          },
          "productCode": {
            "type": "integer",
            "description": "Código do produto. Campo \"Produto\" do componente CAPFM005.",
            "format": "int32"
          },
          "quantity": {
            "type": "number",
            "description": "Quantidade a realizar manutenção.",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "DomainNotificationMessage": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "nullable": true,
            "readOnly": true
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "detailedMessage": {
            "type": "string",
            "nullable": true,
            "readOnly": true
          }
        },
        "additionalProperties": false
      },
      "ProductStorageChangeModel": {
        "type": "object",
        "properties": {
          "startDate": {
            "type": "string",
            "description": "Data/hora inicial de alteração.",
            "format": "date-time",
            "nullable": true
          },
          "endDate": {
            "type": "string",
            "description": "Data/hora final de alteração.",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Filtro por alteração de dados. Este filtro é o primeiro a ser aplicado.\r\n<br>Caso seja informado, irá carregar uma lista de dados alterados, e este sofrerá ação dos demais filtros de forma restritiva, ou seja, como \"E\". Caso não seja informado, os demais filtros serão aplicados a todos os dados da base de dados, também como \"E\".<br>**Caso seja informado o intervalo de data de alteração, obrigatoriamente terá que informar a lista de empresas e pelo menos uma das opções \"in\".**"
      },
      "ProductStorageFilterModel": {
        "type": "object",
        "properties": {
          "change": {
            "$ref": "#/components/schemas/ProductStorageChangeModel"
          },
          "branchCode": {
            "type": "integer",
            "description": "Código da empresa de embalagem. Campo \"Emp.\" do frame \"Localização\" do componente CAPFC002.",
            "format": "int32",
            "nullable": true
          },
          "productCodeList": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            },
            "description": "Lista de códigos de produtos. Campo \"Produto ...\" do componente CAPFC002.",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ProductStorageItemOutModel": {
        "type": "object",
        "properties": {
          "branchCode": {
            "type": "integer",
            "description": "Empresa embalagem. Campo \"Emp. Embalagem\" do frame \"Localização\" componente CAPFC002.",
            "format": "int32"
          },
          "packagingNumber": {
            "type": "integer",
            "description": "Número embalagem. Campo \"Embalagem\" do frame \"Localização\" componente CAPFC002.",
            "format": "int32"
          },
          "localCode": {
            "type": "string",
            "description": "Código local. Campo \"Local\" do frame \"Localização\" componente CAPFC002.",
            "nullable": true
          },
          "localName": {
            "type": "string",
            "description": "Descrição local. Campo \"Local\" do frame \"Localização\" componente CAPFC002.",
            "nullable": true
          },
          "quantity": {
            "type": "number",
            "description": "Quantidade saldo. Campo \"Qt. produto emb.\" do frame \"Localização\" componente CAPFC002.",
            "format": "double"
          },
          "packagingName": {
            "type": "string",
            "description": "Descrição embalagem. Campo \"Descrição Embalagem\" do frame \"Localização\" componente CAPFC002.",
            "nullable": true
          },
          "totalQuantity": {
            "type": "number",
            "description": "Quantidade total embalagem. Campo \"Qt. total emb.\" do frame \"Localização\" componente CAPFC002.",
            "format": "double"
          },
          "balanceType": {
            "type": "integer",
            "description": "Tipo saldo. Campo \"Tipo saldo\" do frame \"Filtro\" componente CAPFC002.",
            "format": "int32",
            "nullable": true
          },
          "balanceName": {
            "type": "string",
            "description": "Descrição tipo saldo. Campo \"Tipo saldo\" do frame \"Filtro\" componente CAPFC002.",
            "nullable": true
          },
          "placePackagingType": {
            "type": "integer",
            "description": "Tipo embalagem do local. Campo \"Tipo emb. local\" do frame \"Localização\" componente CAPFC002.",
            "format": "int32",
            "nullable": true
          },
          "placePackagingName": {
            "type": "string",
            "description": "Descrição tipo embalagem do local. Campo \"Tipo emb. local\" do frame \"Localização\" componente CAPFC002.",
            "nullable": true
          },
          "isAllocated": {
            "type": "boolean",
            "description": "Retorna 'true' quando a embalagem está alocada. Campo \"Aloc.\" do frame \"Localização\" componente CAPFC002.",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ProductStorageOutModel": {
        "type": "object",
        "properties": {
          "productCode": {
            "type": "integer",
            "description": "Produto. Campo \"Produto\" do frame \"Produto\" componente CAPFC002.",
            "format": "int32"
          },
          "maxChangeFilterDate": {
            "type": "string",
            "description": "Maior data de alteração dentro do filtro de intervalo de data. Campo populado apenas quando os campos \r\n<br>\"filter.change.startDate\" e \"filter.change.endDate\" são informados.",
            "format": "date-time",
            "nullable": true
          },
          "storages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductStorageItemOutModel"
            },
            "description": "Lista de embalagens do produto.",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ProductStorageSearchModel": {
        "type": "object",
        "properties": {
          "filter": {
            "$ref": "#/components/schemas/ProductStorageFilterModel"
          },
          "order": {
            "type": "string",
            "description": "Lista de campos para ordenação separados por \",\". Para ordenação descendente utilizar o caracter \"-\".\r\n<br> As seguintes expressões são suportadas: \"productCode\" e \"maxChangeFilterDate\"<br> Ex.: \"order\": \"productCode, maxChangeFilterDate\"",
            "nullable": true
          },
          "page": {
            "type": "integer",
            "description": "Número da página. Página inicial é 1.",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "description": "Quantidade de itens por página. Valor padrão é 100. Valor máximo é 100.",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "ProductStorageSearchResponseModel": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "format": "int32"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          },
          "hasNext": {
            "type": "boolean"
          },
          "totalItems": {
            "type": "integer",
            "format": "int32"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductStorageOutModel"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SubtractQuantityProductPackagingCommand": {
        "required": [
          "branchCode",
          "packagingNumber",
          "productCode",
          "quantity"
        ],
        "type": "object",
        "properties": {
          "branchCode": {
            "type": "integer",
            "description": "Código da empresa. Campo \"Empresa\" do componente CAPFM005.",
            "format": "int32"
          },
          "packagingNumber": {
            "type": "integer",
            "description": "Número da embalagem. Campo \"Código\" do componente CAPFM005.",
            "format": "int32"
          },
          "productCode": {
            "type": "integer",
            "description": "Código do produto. Campo \"Produto\" do componente CAPFM005.",
            "format": "int32"
          },
          "quantity": {
            "type": "number",
            "description": "Quantidade a realizar manutenção.",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "SuccessProcessingModel": {
        "type": "object",
        "properties": {
          "processingDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "UpsertProductPackagingCommand": {
        "required": [
          "branchCode",
          "packagingNumber",
          "productCode",
          "quantity"
        ],
        "type": "object",
        "properties": {
          "branchCode": {
            "type": "integer",
            "description": "Código da empresa. Campo \"Empresa\" do componente CAPFM005.",
            "format": "int32"
          },
          "packagingNumber": {
            "type": "integer",
            "description": "Número da embalagem. Campo \"Código\" do componente CAPFM005.",
            "format": "int32"
          },
          "productCode": {
            "type": "integer",
            "description": "Código do produto. Campo \"Produto\" do componente CAPFM005.",
            "format": "int32"
          },
          "quantity": {
            "type": "number",
            "description": "Quantidade a realizar manutenção.",
            "format": "double"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "apiKey",
        "description": "JWT Authorization header using the Bearer scheme. Example: \"Authorization: Bearer {token}\"",
        "name": "Authorization",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}