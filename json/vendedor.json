            "format": "int32"
          },
          "operationalAreaName": {
            "type": "string",
            "description": "Descrição da região de atuação. Campo \"Descrição\" do bloco 'Região de atuação' do componente PESFL035.",
            "nullable": true
          },
          "cep": {
            "type": "string",
            "description": "Cep. Primeiro campo da coluna \"Logradouro\" do bloco 'Logradouro' do componente PESFM006.",
            "nullable": true
          },
          "maxChangeFilterDate": {
            "type": "string",
            "description": "Maior data de alteração dentro do filtro de intervalo de data. Campo populado apenas quando os campos \"startChangeDate\" e \"endChangeDate\" são informados.",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "OperationalAreaCepOutDto": {
        "type": "object",
        "properties": {
