  "paths": {
    "/api/totvsmoda/seller/v2/search": {
      "post": {
        "tags": [
          "Seller"
        ],
        "summary": "Obter lista de vendedores, empresas e clientes.",
        "requestBody": {
          "description": "",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SellerSearchInDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SellerSearchInDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SellerSearchInDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SellerSearchOutDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DomainNotificationMessage"
                }
              }
            }
          }
        }
      }
    },
    "/api/totvsmoda/seller/v2/operational-area": {
      "get": {
        "tags": [
          "Seller"
        ],
        "summary": "Obter lista de região de atuação de vendedores.",
        "parameters": [
          {
            "name": "StartChangeDate",
            "in": "query",
            "description": "Data/hora inicial de alteração. Campo \"Operador/Atualização\" do componente PEDFL035.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "EndChangeDate",
            "in": "query",
            "description": "Data/hora final de alteração. Campo \"Operador/Atualização\" do componente PEDFL035.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "OperationalAreaCode",
            "in": "query",
            "description": "Código da região de atuação dos vendedores. Campo \"Código\" do bloco \"Região de atuação\" do componente PESFL035.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "OperationalAreaType",
            "in": "query",
            "description": "Tipo de região de atuação. Campo 'Tipo' do componente PESFL035.\r\n<br>1 - Representative(Representante).<br>2 - ShippingCompany(Transportadora).<br>3 - DeliveryDate(Prazo de entrea).<br>4 - CreditLocation(Local de crédito).",
            "schema": {
              "$ref": "#/components/schemas/OperationalAreaType"
            }
          },
          {
            "name": "OperationalAreaGroupCode",
            "in": "query",
            "description": "Agrupamento da região de atuação dos vendedores. Campo \"Agrupamento\" do bloco \"Região de atuação\" do componente PESFL035.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "Order",
            "in": "query",
            "description": " Lista de campos para ordenação separados por \",\". Para ordenação descendente utilizar o caracter \"-\".\r\n As seguintes expressões são suportadas: \"operationalAreaCode\", \"operationalAreaType\", \"operationalAreaGroupCode\" e \"maxChangeFilterDate\"\r\nEx.: \"order\": \"-operationalAreaCode,operationalAreaType\"",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Page",
            "in": "query",
            "description": "Número da página. Página inicial é 1.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "PageSize",
            "in": "query",
            "description": "Quantidade de itens por página. Valor padrão é 1000. Valor máximo é 1000.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "ValidationResult.IsValid",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "ValidationResult.Errors",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/ValidationFailure"
              }
            }
          },
          {
            "name": "ValidationResult.RuleSetsExecuted",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationalAreaOutDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DomainNotificationMessage"
                }
              }
            }
          }
        }
      }
    },
