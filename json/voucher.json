  "components": {
    "schemas": {
      "DomainNotificationMessage": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "nullable": true,
            "readOnly": true
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "detailedMessage": {
            "type": "string",
            "nullable": true,
            "readOnly": true
          }
        },
        "additionalProperties": false
      },
      "InsertVoucherCommand": {
        "required": [
          "branchCodeRegistration",
          "endDate",
          "prefixCode",
          "startDate",
          "status",
          "voucherType"
        ],
        "type": "object",
        "properties": {
          "branchCodeRegistration": {
            "type": "integer",
            "description": "Empresa de cadastro do voucher. Este campo não é apresentado nos componentes do sistema.",
            "format": "int32"
          },
          "description": {
            "type": "string",
            "description": "Descrição do voucher. Campo \"Número\" do componente PDVFM066.\r\n<br>Tamanho máximo: 60 caracteres.",
            "nullable": true
          },
          "voucherType": {
            "$ref": "#/components/schemas/VoucherType"
          },
          "prefixCode": {
            "type": "string",
            "description": "Prefixo do voucher. Campo \"Prefixo\" do componente PDVFM066.\r\n<br>É utilizado para compor o código do voucher juntamente com um número randômico gerado pela API.<br> O código do voucher gerado irá respeitar o tamanho máximo configurado no parâmetro empresa NR_TAMANHO_CD_VOUCHER<br>Tamanho máximo: 10 caracteres"
          },
          "status": {
            "$ref": "#/components/schemas/StatusType"
          },
          "startDate": {
            "type": "string",
            "description": "Data de início do voucher. Campo \"Data início\" do componente PDVFM066.",
            "format": "date-time"
          },
          "endDate": {
            "type": "string",
            "description": "Data de final do voucher. Campo \"Data fim\" do componente PDVFM066.",
            "format": "date-time"
          },
          "percentage": {
            "type": "number",
            "description": "Percentual do voucher. Campo \"Percentual\" do componente PDVFM066.",
            "format": "double",
            "nullable": true
          },
          "value": {
            "type": "number",
            "description": "Valor do voucher. Campo \"Valor\" do componente PDVFM066.",
            "format": "double",
            "nullable": true
          },
          "quantity": {
            "type": "number",
            "description": "Quantidade do voucher. Campo \"Quantidade\" do componente PDVFM066.",
            "format": "double",
            "nullable": true
          },
          "printTemplateCode": {
            "type": "integer",
            "description": "Modelo de impressão do voucher. Campo \"Modelo impressão\" do componente PDVFM066.",
            "format": "int32",
            "nullable": true
          },
          "branchs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VoucherBranchModel"
            },
            "description": "Lista de empresas participantes do voucher.",
            "nullable": true
          },
          "filters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VoucherFilterModel"
            },
            "description": "Lista de filtro do voucher.",
            "nullable": true
          },
          "triggers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VoucherTriggerModel"
            },
            "description": "Lista de gatilhos do voucher.",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "InsertVoucherCustomerCommand": {
        "required": [
          "branchCodeRegistration",
          "voucherNumberBase"
        ],
        "type": "object",
        "properties": {
          "branchCodeRegistration": {
            "type": "integer",
            "description": "Empresa de geração do voucher. Este campo não é apresentado nos componentes do sistema.",
            "format": "int32"
          },
          "voucherNumberBase": {
            "type": "integer",
            "description": "Código do voucher origem. Campo \"Código voucher\" do componente PDVFM066.",
            "format": "int32"
          },
          "customerCodeList": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            },
            "description": "Lista de códigos de clientes que serão utilizados para geração do voucher a partir do voucher origem. Campo \"Código\" do componente PESFM001.\r\n<br>Não pode ser informado simultaneamente com CustomerCpfCnpjList, mas um dos dois deve ser informado obrigatoriamente.",
            "nullable": true
          },
          "customerCpfCnpjList": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Lista de documentos de clientes que serão utilizados para geração do voucher a partir do voucher origem. Campo \"Número CPF/CNPJ\" do componente PESFM010.\r\n<br>Não pode ser informado simultaneamente com CustomerCodeList, mas um dos dois deve ser informado obrigatoriamente.",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "OperationType": {
        "enum": [
          "Equals",
          "Different",
          "GreaterThan",
          "GreaterThanOrEquals",
          "LessThan",
          "LessThanOrEquals",
          "Belongs",
          "NotBelongs"
        ],
        "type": "integer",
        "description": "Tipo de operação. Campo \"Operador\" do componente PDVFM066.\r\n<br>1 - Igual<br>2 - Diferente<br>3 - Maior<br>4 - Maior igual<br>5 - Menor<br>6 - Menor igual<br>7 - Pertence<br>8 - Não pertence",
        "format": "int32"
      },
      "Severity": {
        "enum": [
          "Error",
          "Warning",
          "Info"
        ],
        "type": "integer",
        "format": "int32"
      },
      "StatusType": {
        "enum": [
          "InProgress",
          "Closed",
          "Canceled"
        ],
        "type": "integer",
        "description": "Situação do voucher. Campo \"Situação\" do componente PDVFM066.\r\n<br>1 - Em andamento<br>4 - Encerrado<br>6 - Cancelado",
        "format": "int32"
      },
      "TriggerOperationType": {
        "enum": [
          "Equals",
          "GreaterThan",
          "GreaterThanOrEquals"
        ],
        "type": "integer",
        "description": "Tipo de operador do gatilho. Campo \"Tipo operador\" do campo PDVFM066.\r\n<br>1 - Igual<br>3 - Maior<br>4 - Maior igual",
        "format": "int32"
      },
      "TriggerType": {
        "enum": [
          "Quantity",
          "Value"
        ],
        "type": "integer",
        "description": "Tipo de gatilho. Campo \"Tipo gatilho\" do componente PDVFM066.\r\n<br> 1 - Quantidade<br> 2 - Valor",
        "format": "int32"
      },
      "UpdateVoucherCommand": {
        "required": [
          "status",
          "voucherNumber"
        ],
        "type": "object",
        "properties": {
          "voucherNumber": {
            "type": "integer",
            "description": "Número do voucher. Campo \"Número\" do componente PDVFM066.",
            "format": "int32"
          },
          "description": {
            "type": "string",
            "description": "Descrição do voucher. Campo \"Número\" do componente PDVFM066.\r\n<br>Tamanho máximo: 60 caracteres.",
            "nullable": true
          },
          "voucherType": {
            "$ref": "#/components/schemas/VoucherType"
          },
          "status": {
            "$ref": "#/components/schemas/StatusType"
          },
          "startDate": {
            "type": "string",
            "description": "Data de início do voucher. Campo \"Data início\" do componente PDVFM066.",
            "format": "date-time",
            "nullable": true
          },
          "endDate": {
            "type": "string",
            "description": "Data de final do voucher. Campo \"Data fim\" do componente PDVFM066.",
            "format": "date-time",
            "nullable": true
          },
          "percentage": {
            "type": "number",
            "description": "Percentual do voucher. Campo \"Percentual\" do componente PDVFM066.",
            "format": "double",
            "nullable": true
          },
          "value": {
            "type": "number",
            "description": "Valor do voucher. Campo \"Valor\" do componente PDVFM066.",
            "format": "double",
            "nullable": true
          },
          "quantity": {
            "type": "number",
            "description": "Quantidade do voucher. Campo \"Quantidade\" do componente PDVFM066.",
            "format": "double",
            "nullable": true
          },
          "printTemplateCode": {
            "type": "integer",
            "description": "Modelo de impressão do voucher. Campo \"Modelo impressão\" do componente PDVFM066.",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ValidationFailure": {
        "type": "object",
        "properties": {
          "propertyName": {
            "type": "string",
            "nullable": true
          },
          "errorMessage": {
            "type": "string",
            "nullable": true
          },
          "attemptedValue": {
            "nullable": true
          },
          "customState": {
            "nullable": true
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "errorCode": {
            "type": "string",
            "nullable": true
          },
          "formattedMessagePlaceholderValues": {
            "type": "object",
            "additionalProperties": { },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "VoucherBranchModel": {
        "required": [
          "branchCode"
        ],
        "type": "object",
        "properties": {
          "branchCode": {
            "type": "integer",
            "description": "Empresa participante do voucher. Campo \"Código\" do frame \"Empresa participante\" no componente PDVFM066.",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "VoucherCustomerListResponseModel": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VoucherCustomerResponseModel"
            },
            "description": "Lista de voucher gerados com seus respectivos clientes.",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "VoucherCustomerResponseModel": {
        "type": "object",
        "properties": {
          "voucherNumber": {
            "type": "integer",
            "description": "Número do voucher gerado. Campo \"Número\" do componente PDVFM066.",
            "format": "int32"
          },
          "voucherCode": {
            "type": "string",
            "description": "Código do voucher gerado. Campo \"Código voucher\" do componente PDVFM066.",
            "nullable": true
          },
          "customerCode": {
            "type": "integer",
            "description": "Código de cliente. Campo \"Código\" do componente PESFM010.",
            "format": "int32"
          },
          "customerCpfCnpj": {
            "type": "string",
            "description": "CPF/CNPJ de cliente sem formatação. Campo \"Cpf/Cnpj\" do componente PESFM010.",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "VoucherFilterModel": {
        "required": [
          "filterType",
          "operationType",
          "value"
        ],
        "type": "object",
        "properties": {
          "filterType": {
            "type": "integer",
            "description": "Tipo de filtro. Campo \"Tipo campo\" do frame \"Filtro\" no componente PDVFM066.",
            "format": "int32"
          },
          "operationType": {
            "$ref": "#/components/schemas/OperationType"
          },
          "value": {
            "type": "string",
            "description": "Valor do filtro. Campo \"Valor\" do frame \"Filtro\" no componente PDVFM066."
          }
        },
        "additionalProperties": false
      },
      "VoucherResponseModel": {
        "type": "object",
        "properties": {
          "voucherNumber": {
            "type": "integer",
            "description": "Número do voucher gerado. Campo \"Número\" do componente PDVFM066.",
            "format": "int32"
          },
          "voucherCode": {
            "type": "string",
            "description": "Código do voucher gerado. Campo \"Código voucher\" do componente PDVFM066.",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "VoucherSearchModel": {
        "type": "object",
        "properties": {
          "voucherNumber": {
            "type": "integer",
            "description": "Número do voucher. Campo \"Número\" do componente PDVFM066.",
            "format": "int32"
          },
          "description": {
            "type": "string",
            "description": "Descrição do voucher. Campo \"Número\" do componente PDVFM066",
            "nullable": true
          },
          "prefixCode": {
            "type": "string",
            "description": "Prefixo do voucher. Campo \"Prefixo\" do componente PDVFM066",
            "nullable": true
          },
          "voucherCode": {
            "type": "string",
            "description": "Código do voucher. Campo \"Código voucher\" do componente PDVFM066.",
            "nullable": true
          },
          "voucherType": {
            "$ref": "#/components/schemas/VoucherType"
          },
          "status": {
            "$ref": "#/components/schemas/StatusType"
          },
          "value": {
            "type": "number",
