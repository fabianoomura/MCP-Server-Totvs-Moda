          },
          "startDate": {
            "type": "string",
            "description": "Data início vigência voucher. Campo \"Data início\" do componente PDVFM066",
            "format": "date-time",
            "nullable": true
          },
          "endDate": {
            "type": "string",
            "description": "Data fim vigência voucher. Campo \"Data fim\" do componente PDVFM066",
            "format": "date-time",
            "nullable": true
          },
          "inclusionDate": {
            "type": "string",
            "description": "Data inclusão voucher. Campo \"Data/Hora\" do frame \"Inclusão\" do componente PDVFM066",
            "format": "date-time"
          },
          "customerCode": {
            "type": "integer",
            "description": "Código cliente voucher. Campo \"Cliente\" do componente PDVFM066",
            "format": "int32",
