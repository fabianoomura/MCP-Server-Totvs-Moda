            "description": "Código parceiror voucher. Campo \"Parceiro\" do componente PDVFM066",
            "format": "int32",
            "nullable": true
          },
          "partnerName": {
            "type": "string",
            "description": "Código parceiror voucher. Campo \"Parceiro\" do componente PDVFM066",
            "nullable": true
          },
          "closingDate": {
            "type": "string",
            "description": "Data encerramento voucher. Campo \"Cliente\" do componente PDVFM066",
            "format": "date-time",
            "nullable": true
          },
