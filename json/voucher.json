  "paths": {
    "/api/totvsmoda/voucher/v2/create": {
      "post": {
        "tags": [
          "Voucher"
        ],
        "summary": "Incluir um voucher.",
        "requestBody": {
          "description": "",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InsertVoucherCommand"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/InsertVoucherCommand"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/InsertVoucherCommand"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoucherResponseModel"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DomainNotificationMessage"
                }
              }
            }
          }
        }
      }
    },
    "/api/totvsmoda/voucher/v2/search": {
      "get": {
        "tags": [
          "Voucher"
        ],
        "summary": "Consultar voucher.",
        "parameters": [
          {
            "name": "VoucherNumberList",
            "in": "query",
            "description": "Lista de número de voucher. Campo \"Número\" do componente PDVFM066.",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int32"
              }
            }
          },
          {
            "name": "VoucherCodeList",
            "in": "query",
            "description": "Lista de código de voucher. Campo \"Código voucher\" do componente PDVFM066.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "StartDateInitial",
            "in": "query",
            "description": "Data inicial intervalo de início de vigência voucher. Campo \"Data início\" do componente PDVFM066.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "StartDateFinal",
            "in": "query",
            "description": "Data final intervalo de início de vigência voucher. Campo \"Data início\" do componente PDVFM066.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "EndDateInitial",
            "in": "query",
            "description": "Data inicial intervalo de fim de vigência voucher. Campo \"Data fim\" do componente PDVFM066.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "EndDateFinal",
            "in": "query",
            "description": "Data final intervalo de fim de vigência voucher. Campo \"Data fim\" do componente PDVFM066.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "CustomerCodeList",
            "in": "query",
            "description": "Lista de código de cliente. Campo \"Código\" do componente PESFM010",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int32"
              }
            }
          },
          {
            "name": "CustomerCpfCnpjList",
            "in": "query",
            "description": "Lista de CPF/CNPJ de cliente sem formatação. Campo \"Cpf/Cnpj\" do componente PESFM010",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "Status",
            "in": "query",
            "description": "Tipo de situação. Campo \"Situação\" do componente PDVFM066\".\r\n<br>1 - Em andamento<br>4 - Encerrado<br>6 - Cancelado",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/StatusType"
              }
            }
          },
          {
            "name": "Page",
            "in": "query",
            "description": "Número da página. Página inicial é 1.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "PageSize",
            "in": "query",
            "description": "Quantidade de itens por página. Valor padrão é 100. Valor máximo é 1000.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "ValidationResult.IsValid",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "ValidationResult.Errors",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/ValidationFailure"
              }
            }
          },
          {
            "name": "ValidationResult.RuleSetsExecuted",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoucherSearchResponseModel"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DomainNotificationMessage"
                }
              }
            }
          }
        }
      }
    },
    "/api/totvsmoda/voucher/v2/update": {
      "post": {
        "tags": [
          "Voucher"
        ],
        "summary": "Alterar um voucher.",
        "requestBody": {
          "description": "",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateVoucherCommand"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateVoucherCommand"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateVoucherCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoucherResponseModel"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DomainNotificationMessage"
                }
              }
            }
          }
        }
      }
    },
    "/api/totvsmoda/voucher/v2/customer/create": {
      "post": {
        "tags": [
          "Voucher"
        ],
        "summary": "Incluir voucher para uma lista de clientes baseado em um voucher pai.",
        "requestBody": {
          "description": "",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InsertVoucherCustomerCommand"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/InsertVoucherCustomerCommand"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/InsertVoucherCustomerCommand"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoucherCustomerListResponseModel"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DomainNotificationMessage"
                }
              }
            }
          }
        }
      }
    }
