# =============================================================================
# TOTVS Moda MCP Server — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o arquivo .env no repositório.

# URL base do servidor TOTVS Moda (sem trailing slash)
# Exemplo: https://totvs.suaempresa.com.br:9443
TOTVS_BASE_URL=https://seu-servidor-totvs:9443

# Credenciais OAuth2 (Resource Owner Password Credentials)
# CLIENT_ID padrão da plataforma TOTVS Moda — normalmente não muda
TOTVS_CLIENT_ID=seu_client_id
TOTVS_CLIENT_SECRET=

# Usuário de integração TOTVS
TOTVS_USERNAME=
TOTVS_PASSWORD=

# Filiais (branchCode) que este servidor gerencia.
# Informe os códigos separados por vírgula.
# Exemplo com múltiplas filiais: TOTVS_BRANCH_CODES=1,2,5
TOTVS_BRANCH_CODES=1

# Defaults operacionais carregados no contexto inicial.
# Ajuste conforme a empresa antes de iniciar o MCP.
TOTVS_DEFAULT_PRICE_CODES=1
TOTVS_DEFAULT_COST_CODES=1,2,3
TOTVS_DEFAULT_STOCK_CODES=1

# Perfil de exposição das tools MCP.
# Opções: completo, leitura, vendedor, financeiro, gestor.
# Padrão: completo
TOTVS_PROFILE=completo

# Adiciona/remove tools individuais sobre o perfil escolhido.
# Separe múltiplas tools por vírgula.
# TOTVS_TOOLS_EXTRA=totvs_cancel_order
# TOTVS_TOOLS_EXCLUDE=totvs_update_product_price

# =============================================================================
# Módulos opcionais — defina "false" para desabilitar
# =============================================================================

# Módulo Analytics: movimentação fiscal, painel financeiro, painel de vendedor,
# ranking e-commerce. Desabilite se a empresa não contrata este módulo TOTVS.
# Padrao: false
TOTVS_ENABLE_ANALYTICS=false

# Verificação TLS do servidor TOTVS.
# Defina "false" APENAS se o servidor usa certificado autoassinado e você
# aceita o risco de MITM na sua rede interna.
# Padrão: true (recomendado)
TOTVS_TLS_VERIFY=true
